@startuml
title Class Diagram - TravelWise Domain Model (updated, as implemented)

class Profile {
  +id : UUID
  +name : String
  +role : String  ' employee | supervisor | administrator
  +created_at : DateTime
}

class TravelRequest {
  +id : UUID
  +user_id : UUID
  +origin : String
  +destination : String
  +travel_class : String
  +purpose : String
  +start_date : Date
  +end_date : Date
  +estimated_cost : Decimal
  +predicted_cost : Decimal
  +status : String  ' pending | approved | rejected
  +selected_option_id : UUID
  +decided_by : UUID
  +decided_at : DateTime
  +created_at : DateTime
}

class TravelOption {
  +id : UUID
  +request_id : UUID
  +type : String
  +cost : Decimal
  +duration : Decimal
  +score : Decimal
  +created_at : DateTime
}

class Policy {
  +id : UUID
  +rule : String
  +condition : String  ' "class=Economy" | "destination=Mumbai" | "*"
  +threshold : Decimal
  +active : Boolean
  +created_at : DateTime
  +evaluate(option, request) : Boolean
}

class "CostPredictionService" as CPS <<emerging tech>> {
  +modelVersion : String
  +r2Score : Decimal
  +predictCost(origin, destination, daysToDeparture, travelClass) : Decimal
}

Profile "1" -- "0..*" TravelRequest : raises >
TravelRequest "1" *-- "1..*" TravelOption : generates >
TravelRequest ..> CPS : uses >
Profile "1" -- "0..*" TravelRequest : decides >
TravelOption "0..*" -- "0..*" Policy : evaluated against >

note bottom of TravelRequest
  Approval and AuditLog are NOT separate
  tables in the implemented system —
  approval state is simplified into fields
  directly on TravelRequest. Policy IS a
  real, active table (see 2.2, 4.2). See
  Limitations (5.4) for what's still
  simplified.
end note

@enduml
