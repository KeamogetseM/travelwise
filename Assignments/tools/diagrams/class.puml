@startuml
skinparam classAttributeIconSize 0
hide circle
title Class Diagram - TravelWise Domain Model (Assignment 4, as implemented)

class Profile {
  +id : UUID
  +name : String
  +role : String  ' employee | supervisor | administrator
  +created_at : DateTime
}

class TravelRequest {
  +id : UUID
  +user_id : UUID
  +origin : String
  +destination : String
  +travel_class : String
  +purpose : String
  +start_date : Date
  +end_date : Date
  +estimated_cost : Decimal
  +predicted_cost : Decimal
  +status : String  ' pending | approved | rejected
  +created_at : DateTime
}

class TravelOption {
  +id : UUID
  +request_id : UUID
  +type : String
  +cost : Decimal
  +duration : Decimal
  +score : Decimal
  +created_at : DateTime
}

class Policy {
  +id : UUID
  +rule : String
  +condition : String  ' "class=Economy" | "destination=Mumbai" | "*"
  +threshold : Decimal
  +active : Boolean
  +evaluate(option, request) : Boolean
}

class Approval {
  +id : UUID
  +request_id : UUID
  +option_id : UUID
  +status : String  ' approved | rejected
  +comment : String
  +approver_id : UUID
  +decision_date : DateTime
}

class AuditLog {
  +id : UUID
  +user_id : UUID
  +action : String
  +details : String
  +timestamp : DateTime
}

class "CostPredictionService" as CPS <<emerging tech>> {
  +modelVersion : String
  +r2Score : Decimal
  +predictCost(origin, destination, daysToDeparture, travelClass) : Decimal
}

Profile "1" -- "0..*" TravelRequest : raises >
TravelRequest "1" *-- "1..*" TravelOption : generates >
TravelRequest ..> CPS : uses >
TravelRequest "1" -- "0..1" Approval : decided by >
Profile "1" -- "0..*" Approval : approves >
TravelOption "0..*" -- "0..*" Policy : evaluated against >
Profile "1" -- "0..*" AuditLog : performs >

@enduml
