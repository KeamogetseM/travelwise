@startuml
title Entity-Relationship Diagram - TravelWise (Assignment 4, Supabase / PostgreSQL, as implemented)

entity "profiles" as profiles {
  * id : uuid <<PK, = auth.users.id>>
  --
  name : text
  role : text <<check: employee|supervisor|administrator>>
  created_at : timestamptz
}

entity "travel_requests" as requests {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK -> profiles.id>>
  origin : text <<check: 6 trained cities>>
  destination : text <<check: 6 trained cities>>
  travel_class : text <<check: Economy|Business>>
  purpose : text
  start_date : date
  end_date : date <<check: end >= start>>
  estimated_cost : numeric <<check >= 0>>
  predicted_cost : numeric <<check >= 0>>
  status : text <<check: pending|approved|rejected>>
  created_at : timestamptz
}

entity "travel_options" as options {
  * id : uuid <<PK>>
  --
  request_id : uuid <<FK -> travel_requests.id>>
  type : text
  cost : numeric <<check >= 0>>
  duration : numeric <<check >= 0>>
  score : numeric <<check >= 0>>
  created_at : timestamptz
}

entity "policies" as policies {
  * id : uuid <<PK>>
  --
  rule : text
  condition : text <<"class=X" | "destination=Y" | "*">>
  threshold : numeric <<check > 0>>
  active : boolean
  created_at : timestamptz
}

entity "approvals" as approvals {
  * id : uuid <<PK>>
  --
  request_id : uuid <<FK -> travel_requests.id, unique>>
  option_id : uuid <<FK -> travel_options.id, nullable>>
  status : text <<check: approved|rejected>>
  comment : text
  approver_id : uuid <<FK -> profiles.id>>
  decision_date : timestamptz
}

entity "audit_log" as audit {
  * id : uuid <<PK>>
  --
  user_id : uuid <<FK -> profiles.id>>
  action : text
  details : text
  timestamp : timestamptz
}

profiles ||--o{ requests : "raises (user_id)"
requests ||--|{ options : "generates (request_id)"
requests ||--o| approvals : "decided via (request_id)"
options ||--o{ approvals : "selected as (option_id)"
profiles ||--o{ approvals : "approves (approver_id)"
profiles ||--o{ audit : "performs (user_id)"
options }o..o{ policies : "evaluated against\n(app-level, by condition\nmatch — no FK)"

@enduml
